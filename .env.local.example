# Supabase — copy from Project Settings → API in the Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: tighten RLS to a specific user UUID (from Dashboard → Auth → Users)
# Uncomment and set if you want per-user RLS instead of role-based
# OWNER_UID=your-user-uuid-here
